@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="d-flex flex-column min-vh-100">
    <!-- Navbar Header -->
    <header class="app-navbar">
        <div class="container d-flex align-items-center justify-content-between">
            <!-- Brand Logo -->
            <a href="" class="navbar-brand-logo">
                <i class="bi bi-stars"></i>
                <span>SmartService</span>
            </a>

            <!-- Nav Links -->
            <nav class="d-none d-md-flex align-items-center gap-2">
                <NavLink class="nav-link-custom" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-house-door me-1"></i> الرئيسية
                </NavLink>
                <NavLink class="nav-link-custom" href="services">
                    <i class="bi bi-grid me-1"></i> الخدمات
                </NavLink>
                <NavLink class="nav-link-custom" href="providers">
                    <i class="bi bi-people me-1"></i> مزودو الخدمات
                </NavLink>
                <NavLink class="nav-link-custom" href="my-bookings">
                    <i class="bi bi-calendar-check me-1"></i> حجوزاتي
                </NavLink>
            </nav>

            <!-- Actions / Account -->
            <div class="d-flex align-items-center gap-3">
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light text-primary border py-2 px-3 d-none d-sm-inline-flex align-items-center gap-2 rounded-pill">
                                <i class="bi bi-person-circle fs-6"></i>
                                <span class="fw-semibold">@(context.User.Identity?.Name ?? "المستخدم")</span>
                            </span>
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right me-1"></i> خروج
                            </button>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login" class="btn btn-outline-custom d-none d-sm-inline-flex">
                            <i class="bi bi-box-arrow-in-left me-1"></i> تسجيل الدخول
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
                <a href="services" class="btn btn-primary-gradient">
                    <i class="bi bi-plus-lg me-1"></i> احجز خدمة الآن
                </a>
            </div>
        </div>
    </header>

    <!-- Main Page Content -->
    <main class="flex-grow-1">
        @Body
    </main>

    <!-- Modern Footer -->
    <footer class="app-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <a href="" class="navbar-brand-logo mb-3 text-white">
                        <i class="bi bi-stars"></i>
                        <span class="text-white">SmartService</span>
                    </a>
                    <p class="text-muted mt-2">
                        المنصة الذكية الأولى لحجز الخدمات المنزلية والاستشارية والفنية بسرعة وسهولة وبأعلى جودة مضمونة.
                    </p>
                    <div class="d-flex gap-3 fs-5 mt-3 text-white">
                        <a href="#" class="text-muted"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="text-muted"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-muted"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-muted"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-title">روابط سريعة</h5>
                    <ul class="footer-links">
                        <li><a href="">الرئيسية</a></li>
                        <li><a href="services">الخدمات المتاحة</a></li>
                        <li><a href="providers">نخبة المزودين</a></li>
                        <li><a href="my-bookings">متابعة الحجوزات</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-title">أبرز التصنيفات</h5>
                    <ul class="footer-links">
                        <li><a href="services">الصيانة المنزلية والتكييف</a></li>
                        <li><a href="services">الخدمات الفنية والكهرباء</a></li>
                        <li><a href="services">التنظيف والتعقيم الشامل</a></li>
                        <li><a href="services">الاستشارات والتدريب</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-title">الدعم والمساعدة</h5>
                    <ul class="footer-links">
                        <li><i class="bi bi-envelope me-2"></i> support@smartservice.com</li>
                        <li><i class="bi bi-telephone me-2"></i> +966 9200 0000</li>
                        <li><i class="bi bi-geo-alt me-2"></i> المملكة العربية السعودية</li>
                    </ul>
                </div>
            </div>

            <hr class="my-4 border-secondary opacity-25">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-muted small">
                <div>جميع الحقوق محفوظة © 2026 - منصة SmartService Booking Platform</div>
                <div class="d-flex gap-3 mt-2 mt-md-0">
                    <a href="#" class="text-muted">سياسة الخصوصية</a>
                    <a href="#" class="text-muted">الشروط والأحكام</a>
                </div>
            </div>
        </div>
    </footer>
</div>

@code {
    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
