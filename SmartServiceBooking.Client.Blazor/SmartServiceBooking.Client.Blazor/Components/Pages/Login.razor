@page "/login"
@rendermode InteractiveServer
@using SmartServiceBooking.Shared.DTOs.Auth
@using SmartServiceBooking.Client.Blazor.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>تسجيل الدخول - SmartService Booking Platform</PageTitle>

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary p-3 mb-3" style="width: 70px; height: 70px; background: var(--primary-light);">
                        <i class="bi bi-box-arrow-in-left fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark">تسجيل الدخول</h3>
                    <p class="text-muted small">مرحباً بك مجدداً! أدخل بيانات حسابك للوصول إلى المنصة</p>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger rounded-3 d-flex align-items-center mb-4 py-2 px-3 small">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-2 flex-shrink-0"></i>
                        <div>@ErrorMessage</div>
                    </div>
                }

                @if (IsSuccess)
                {
                    <div class="alert alert-success rounded-3 text-center mb-4 py-2 px-3 small">
                        <i class="bi bi-check-circle-fill me-1"></i> تم تسجيل الدخول بنجاح! جاري تحويلك...
                    </div>
                }

                <EditForm Model="LoginForm" OnValidSubmit="HandleLogin" FormName="LoginForm">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">البريد الإلكتروني</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                            <InputText class="form-control bg-light" @bind-Value="LoginForm.Email" placeholder="example@domain.com" disabled="@IsLoading" />
                        </div>
                        <ValidationMessage For="@(() => LoginForm.Email)" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">كلمة المرور</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock text-muted"></i></span>
                            <InputText type="password" class="form-control bg-light" @bind-Value="LoginForm.Password" placeholder="••••••••" disabled="@IsLoading" />
                        </div>
                        <ValidationMessage For="@(() => LoginForm.Password)" class="text-danger small mt-1" />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4 small">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMe" @bind="LoginForm.RememberMe" disabled="@IsLoading" />
                            <label class="form-check-label text-secondary" for="rememberMe">تذكرني</label>
                        </div>
                        <a href="#" class="text-primary fw-bold">نسيت كلمة المرور؟</a>
                    </div>

                    <button type="submit" class="btn btn-primary-gradient w-100 py-3 mb-3 d-flex align-items-center justify-content-center gap-2" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>جاري التحقق والاتصال...</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-left"></i>
                            <span>دخول للحساب</span>
                        }
                    </button>
                </EditForm>

                <div class="text-center text-muted small mt-3">
                    ليس لديك حساب؟ <a href="register-customer" class="text-primary fw-bold">إنشاء حساب جديد</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private LoginRequest LoginForm { get; set; } = new();
    private bool IsLoading { get; set; } = false;
    private bool IsSuccess { get; set; } = false;
    private string? ErrorMessage { get; set; }

    private async Task HandleLogin()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;
            IsSuccess = false;

            var result = await AuthService.LoginAsync(LoginForm);

            if (result is not null && !string.IsNullOrEmpty(result.AccessToken))
            {
                IsSuccess = true;
                StateHasChanged();

                await Task.Delay(400);

                var targetUrl = !string.IsNullOrWhiteSpace(ReturnUrl) ? ReturnUrl : "/";
                Navigation.NavigateTo(targetUrl, forceLoad: true);
            }
            else
            {
                ErrorMessage = "البريد الإلكتروني أو كلمة المرور غير صحيحة، يرجى التحقق وإعادة المحاولة.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"فشل الاتصال بالخادم: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
