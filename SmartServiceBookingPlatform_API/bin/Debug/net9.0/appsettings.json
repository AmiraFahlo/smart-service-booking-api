{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseOptions": {
    "ConnectionString": "Server=.;Database=SmartServiceBooking_API1;Trusted_Connection=True;TrustServerCertificate=True;",
    "MaxRetryCount": 3,
    "CommandTimeout": 30,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },
  "JwtSettings": {
    "Secret": "ReplaceThisWithAVeryLongSuperSecretKeyForDevelopmentOnly!123",
    "Issuer": "SmartServiceBookingAPI",
    "Audience": "SmartServiceBookingClient",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "ApiDocumentation": {
    "ExposeInProduction": false,
    "Title": "Smart Service Booking API",
    "Description": "API for the Smart Service Booking Platform. Built with Clean Architecture and .NET 9."
  }
}